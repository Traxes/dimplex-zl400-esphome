  (text "PCB3 Ventilation Lab Setup - emulates the Dimplex ZL 300/400 VF terminal board (PCB3)"
    (at 25.4 20.32 0)
    (effects (font (size 2.5 2.5) (bold yes)) (justify left))
    (uuid "20b5f8ab-7538-475d-a23c-b59b0ede58df")
  )
  (text "AUS_0..4: emulated unit outputs. DIP switch ON pulls the line to GND through 2.2k (open-collector style).\nGreen LED = this output is active. Wire each ESP optocoupler input between +24V and its AUS line."
    (at 88.9 35.56 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid "15bc982a-d910-45e5-94bd-dd75173e9ac1")
  )
  (text "EIN_0/1: emulated unit inputs.\nRed LED lights while the ESP relay\nputs +24V on the line."
    (at 228.6 35.56 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid "a3549b88-8766-4070-a14e-590334016cfd")
  )
  (text "AUS_0 fault/filter, AUS_1 level 1, AUS_2 level 2, AUS_3 level 3, AUS_4 auto.   EIN_0 up, EIN_1 down."
    (at 88.9 160.02 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid "9a4f0a83-4f81-4a3d-9501-7d4b8f349fe7")
  )
  (text "24 V supply pass-through.\nPin 1 = +24V, pin 2 = GND\non both terminals."
    (at 25.4 35.56 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid "49bc6b34-6ca1-428b-a54e-260a112505ad")
  )
